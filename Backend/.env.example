PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/onlineJudge
CLIENT_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h

# Docker judge settings. Keep disabled until the images are installed and the
# API host has permission to invoke Docker.
JUDGE_ENGINE=disabled
JUDGE_NODE_IMAGE=node:20-alpine
JUDGE_PYTHON_IMAGE=python:3.12-alpine
JUDGE_JAVA_IMAGE=eclipse-temurin:21-jdk-alpine
JUDGE_TIMEOUT_MS=5000
JUDGE_OUTPUT_LIMIT_BYTES=65536
JUDGE_MEMORY=128m
JUDGE_CPUS=0.5
JUDGE_MAX_CONCURRENT=2
